{
  "name": "pi-durable-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "build": "vite build",
    "start": "tsx src/server/index.ts --production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "tsx scripts/live-check.ts",
    "gen:docs": "tsx scripts/gen-tool-catalog.ts && tsx scripts/gen-section-catalog.ts",
    "verify:docs": "tsx scripts/gen-tool-catalog.ts --check && tsx scripts/gen-section-catalog.ts --check",
    "doc:check": "tsx scripts/doc-sync.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run doc:check",
    "test:smoke": "tsx scripts/smoke-check.ts",
    "test:live:tools": "tsx scripts/live-tools-check.ts",
    "test:live:codemode": "tsx scripts/live-codemode-check.ts",
    "test:live:skills": "tsx scripts/live-skills-check.ts",
    "test:live:policy": "tsx scripts/live-prompt-policy-check.ts",
    "test:live:workflow": "tsx scripts/live-workflow-check.ts",
    "test:live:prompt": "tsx scripts/live-prompt-check.ts",
    "test:live:bots": "tsx scripts/live-bots-check.ts",
    "test:live:doc-keeper": "tsx scripts/live-doc-keeper-check.ts",
    "test:live:memory": "tsx scripts/live-memory-check.ts"
  },

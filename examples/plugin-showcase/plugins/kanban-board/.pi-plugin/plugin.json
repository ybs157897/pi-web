{
  "name": "kanban-board",
  "version": "1.0.0",
  "description": "An interactive kanban board rendered inline and in the right workspace panel.",
  "author": { "name": "pi-web showcase" },
  "mcpServers": {
    "board": {
      "command": "node",
      "args": ["${PLUGIN_ROOT}/server.mjs"],
      "exposure": "direct"
    }
  },
  "ui": {
    "surfaces": [
      { "id": "board", "title": "Kanban Board", "server": "board", "resourceUri": "ui://kanban/board" }
    ]
  }
}

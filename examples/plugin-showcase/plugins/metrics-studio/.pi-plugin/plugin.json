{
  "name": "metrics-studio",
  "version": "1.0.0",
  "description": "A polished metrics dashboard with KPI tiles, a CSS bar chart, and bridge actions.",
  "author": { "name": "pi-web showcase" },
  "mcpServers": {
    "metrics": {
      "command": "node",
      "args": ["${PLUGIN_ROOT}/server.mjs"],
      "exposure": "direct"
    }
  },
  "ui": {
    "surfaces": [
      { "id": "dashboard", "title": "Metrics Studio", "server": "metrics", "resourceUri": "ui://metrics/dashboard" }
    ]
  }
}
